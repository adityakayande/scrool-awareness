<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg_primary">#0A0A0A</color>
    <color name="bg_secondary">#1A1A1A</color>
    <color name="bg_tertiary">#242424</color>
    <color name="color_danger">#EF4444</color>
    <color name="color_rising_danger">#F97316</color>
    <color name="color_safe">#22C55E</color>
    <color name="color_warning">#EAB308</color>
    <color name="divider">#222222</color>
    <color name="text_hint">#444444</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#888888</color>
    <string name="accessibility_service_desc">This app uses Accessibility Service to detect scrolling behavior for digital wellbeing purposes.</string>
    <string name="accessibility_service_name">Instagram Scroll Tracker</string>
    <string name="app_name">Scroll Awareness</string>
    <style name="Theme.ScrollTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_secondary</item>
        <item name="android:colorBackground">@color/bg_primary</item>

        
        <item name="colorPrimary">@color/color_danger</item>
        <item name="colorPrimaryVariant">@color/color_danger</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <item name="colorSecondary">@color/color_danger</item>
        <item name="colorSecondaryVariant">@color/color_danger</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>

        
        <item name="elevationOverlayEnabled">true</item>

        
        <item name="materialButtonStyle">@style/Widget.ScrollTracker.Button</item>
    </style>
    <style name="Theme.ScrollTracker.Toolbar" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:background">@color/bg_primary</item>
    </style>
    <style name="Widget.ScrollTracker.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/bg_secondary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
</resources>